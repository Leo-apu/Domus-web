# Configuración de EmailJS para envío de correos desde la web
# Duplica este archivo como .env y coloca tus valores reales:
VITE_EMAILJS_SERVICE_ID=tu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=tu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=tu_public_key_aqui

# URL de la aplicación web de Google Apps Script vinculada a tu Google Sheet
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU_CODIGO_AQUI/exec
