# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Duplicá este archivo como .env o .env.local y colocá tus valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase (Autenticación y Cloud Firestore para el Panel CMS / Admin)
# Obtené estos datos en Firebase Console -> Configuración del Proyecto
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=tu_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_firebase_app_id

# ------------------------------------------------------------------------------
# 2. Google Sheets & Apps Script (Cotizador en vivo y sincronización de reservas)
# URL de la aplicación web desplegada en Google Apps Script (/exec)
# ------------------------------------------------------------------------------
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU_CODIGO_AQUI/exec

# ------------------------------------------------------------------------------
# 3. Cloudinary (Subida y optimización de fotos desde el Admin Modal)
# Crear un Upload Preset 'Unsigned' en Cloudinary Settings -> Upload
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_unsigned

# ------------------------------------------------------------------------------
# 4. Google Gemini IA (Asistente inteligente de descripciones y comodidades)
# Obtené una clave gratuita en Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui

# ------------------------------------------------------------------------------
# 5. EmailJS (Formulario de contacto general de la landing page)
# Obtené tus credenciales en EmailJS Dashboard (https://dashboard.emailjs.com/)
# ------------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=tu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=tu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=tu_public_key_aqui
