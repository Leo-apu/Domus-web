rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 🏢 Departamentos: Cualquier visitante puede verlos, solo el Admin autenticado puede modificar
    match /apartments/{apartmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ⚙️ Ajustes generales: Lectura pública, escritura solo para el Admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
